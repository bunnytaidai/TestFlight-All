#!name = TestFlight Đa Tài Khoản, Mở Khóa Thiết Bị & Tải Nhanh CDN (FastClick)
#!desc = Lưu giữ phiên nhiều tài khoản Apple ID, tự động đổi nick khi bấm biểu tượng Tài khoản (/v1/devices), mở khóa tương thích iOS/iPadOS/macOS và tối ưu tải CDN.
#!openUrl = https://testflight.apple.com/join/LPQmtkUs
#!author = VirgilClyne & DecoAri & Hely-T (v5.0.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!select = Switch, true, false
#!select = CountryCode, US, VN, AUTO, SG, JP, TW, GB
#!select = MultiAccount, true, false
#!select = Universal, true, false
#!date = 2026-11-15 23:20:00

[Rule]
DOMAIN-KEYWORD, testflight.apple.com, DIRECT
DOMAIN-SUFFIX, beta.apple.com, DIRECT

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/v1\/devices(\?.*)?$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/switcher/box.switcher.js, timeout = 25, tag = Đổi Nick Apple ID (BoxSwitcher)
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/(session\/authenticate|properties\/testflight|accounts\/.*|messages\/.*|apps\/.*)$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.request.viethoa.js, requires-body = true, timeout = 30, tag = TestFlight Multi-Account Request, argument = [Switch, CountryCode, MultiAccount, Universal]
http-response ^https?:\/\/testflight\.apple\.com\/v\d\/(session\/authenticate|accounts\/.*\/apps.*)$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.response.viethoa.js, requires-body = true, timeout = 30, tag = TestFlight Multi-Account Response, argument = [Switch, CountryCode, MultiAccount, Universal]
http-request ^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps\/.*\/builds\/.*\/install$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Download.js, requires-body = true, timeout = 25, tag = TestFlight Tải Nhanh CDN, argument = [CountryCode]

[Mitm]
hostname = testflight.apple.com
