#!name = Chẩn Đoán Kết Nối CDN & Kiểm Định MitM TestFlight v5.4.0.0 (Chuẩn Loon 3.5+ — tf-diag.test)
#!desc = Tối ưu DIRECT cụm Apple Beta CDN, đo độ trễ thực tế (đã sửa lỗi timeout ms trên Loon 3.5+) và bắt bệnh chứng chỉ CA / HTTP2 / 401 / 429 tại http://tf-diag.test/
#!openUrl = http://tf-diag.test/
#!author = Hely-T & Antigravity (v5.4.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!date = 2026-11-20 15:20:00

[General]
force-http-engine-hosts = tf-diag.test

[Rule]
DOMAIN, tf-diag.test, DIRECT
DOMAIN-KEYWORD, testflight.apple.com, DIRECT
DOMAIN-SUFFIX, beta.apple.com, DIRECT
DOMAIN-SUFFIX, iosapps.itunes.apple.com, DIRECT
DOMAIN-SUFFIX, osxapps.itunes.apple.com, DIRECT
DOMAIN-SUFFIX, mzstatic.com, DIRECT

[Host]
tf-diag.test = 127.0.0.1

[Script]
http-request ^http:\/\/tf-diag\.test(\/.*)?$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Network_Diagnostics.js, timeout = 20, tag = Bảng Chẩn Đoán Mạng MitM
http-response ^https?:\/\/testflight\.apple\.com\/v\d\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Network_Diagnostics.js, timeout = 15, tag = Nhật Ký Chẩn Đoán Mạng RO

[Mitm]
hostname = testflight.apple.com
