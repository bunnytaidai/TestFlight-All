#!name = BoxJs (Quản Lý Đa Tài Khoản Apple ID & APP_ID)
#!desc = Giao diện web quản lý danh sách nick Apple ID, chuyển đổi phiên tự động và cấu hình APP_ID (http://boxjs.com)
#!openUrl = http://boxjs.com
#!author = chavyleung & Hely-T (v4.6.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/box.png

[Rule]
DOMAIN-SUFFIX, boxjs.com, DIRECT
DOMAIN-SUFFIX, boxjs.net, DIRECT

[Rewrite]
^https?:\/\/(.+\.)?boxjs\.(com|net) https://boxjs.com 302

[Script]
http-request ^https?:\/\/(.+\.)?boxjs\.(com|net) script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/chavy.boxjs.js, requires-body = true, tag = BoxJs, timeout = 120

[Mitm]
hostname = boxjs.com, *.boxjs.com, boxjs.net, *.boxjs.net
