#!name = BoxJs (Quản Lý Đa Tài Khoản Apple ID & APP_ID — Chống Lỗi DNS)
#!desc = Giao diện web quản lý danh sách nick Apple ID, chuyển đổi phiên tự động và cấu hình APP_ID (http://boxjs.com) — đã gắn sẵn [Host] 127.0.0.1 không bao giờ lỗi mạng.
#!openUrl = http://boxjs.com
#!author = chavyleung & Hely-T (v5.0.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/box.png
#!date = 2026-11-15 23:20:00

[General]
force-http-engine-hosts = boxjs.com, *.boxjs.com, boxjs.net, *.boxjs.net

[Rule]
DOMAIN-SUFFIX, boxjs.com, DIRECT
DOMAIN-SUFFIX, boxjs.net, DIRECT
DOMAIN-SUFFIX, jsdelivr.net, DIRECT

[Host]
boxjs.com = 127.0.0.1
*.boxjs.com = 127.0.0.1
boxjs.net = 127.0.0.1
*.boxjs.net = 127.0.0.1

[Script]
http-request ^https?:\/\/(.+\.)?boxjs\.(com|net) script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/chavy.boxjs.js, requires-body = true, timeout = 120, tag = BoxJs Panel

[Mitm]
hostname = boxjs.com, *.boxjs.com, boxjs.net, *.boxjs.net
