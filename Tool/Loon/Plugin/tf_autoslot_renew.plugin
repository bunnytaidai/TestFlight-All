#!name=Rabbit TestFlight Multi-Account AutoJoin & Sub Guard
#!desc=Lưu đa nick Apple ID, tự đảo nick săn 5 link TestFlight (LPQmtkUs, Xh9VNQoA, 2mcx1R3I, YSo8aVCS, CzpZHGuS) và theo dõi gói đăng ký cố định.
#!author=Rabbit-Antidv
#!system=ios,macos

[Argument]
TF_CODES = input, "LPQmtkUs,Xh9VNQoA,2mcx1R3I,YSo8aVCS,CzpZHGuS", tag = Danh sách mã TestFlight cần săn
TARGET_PRODUCTS = input, "*", tag = Mã gói cần giữ gia hạn (* là tất cả)
JOIN_ALL = switch, false, tag = Ép mọi nick cùng vào đủ 5 link
CRON_EXP = input, "*/20 * * * * *", tag = Chu kỳ đảo nick quét slot (Cron)

[Rule]
# Chặn UDP 443 ép TestFlight và StoreKit hạ từ QUIC (HTTP/3) xuống TLS/TCP chuẩn
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,apple.com)),REJECT
DOMAIN,testflight.apple.com,DIRECT
DOMAIN,buy.itunes.apple.com,DIRECT
DOMAIN,sandbox.itunes.apple.com,DIRECT
DOMAIN,mzstorekit-sb.itunes.apple.com,DIRECT
DOMAIN,api.storekit-sandbox.itunes.apple.com,DIRECT

[Script]
# 1. Tự động bắt và lưu cấu hình từng nick Apple ID khi làm mới TestFlight
http-request ^https:\/\/testflight\.apple\.com\/v[23]\/accounts\/([0-9a-fA-F-]+)\/apps script-path=http://192.168.1.100:8899/tf_manager_core.js, requires-body=false, timeout=15, tag=TF_Luu_AppleID

# 2. Kiểm tra danh sách gói đăng ký đã mua trên StoreKit 1 (verifyReceipt)
http-response ^https:\/\/(buy|sandbox)\.itunes\.apple\.com\/verifyReceipt script-path=http://192.168.1.100:8899/tf_manager_core.js, requires-body=true, max-size=524288, timeout=20, tag=TF_KiemTra_Goi_SK1

# 3. Kiểm tra danh sách gói đăng ký đã mua trên StoreKit 2 (JWS Sandbox)
http-response ^https:\/\/(mzstorekit-sb\.itunes\.apple\.com|api\.storekit-sandbox\.itunes\.apple\.com)\/.* script-path=http://192.168.1.100:8899/tf_manager_core.js, requires-body=true, max-size=524288, timeout=20, tag=TF_KiemTra_Goi_SK2

# 4. Tiến trình ngầm tự động đảo nick săn 5 link & canh chu kỳ gia hạn
cron {CRON_EXP} script-path=http://192.168.1.100:8899/tf_manager_core.js, timeout=25, argument=[{TF_CODES},{TARGET_PRODUCTS},{JOIN_ALL}], tag=TF_DaoNick_SanSlot_GiaHan

[MITM]
hostname = testflight.apple.com, buy.itunes.apple.com, sandbox.itunes.apple.com, mzstorekit-sb.itunes.apple.com, api.storekit-sandbox.itunes.apple.com
