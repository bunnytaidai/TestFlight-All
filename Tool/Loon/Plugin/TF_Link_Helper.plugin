#!name = Trợ Lý Bắt Link & Quản Lý Hàng Đợi TestFlight v5.4.0.0 (Chuẩn Loon 3.5+ — tf-link.test)
#!desc = Tự động gom mọi link testflight.apple.com/join/XXXX vào hàng đợi săn, hỗ trợ mở thẳng itms-beta:// và quản lý hàng loạt link offline tại http://tf-link.test/
#!openUrl = http://tf-link.test/
#!author = Hely-T & Antigravity (v5.4.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!date = 2026-11-20 15:20:00

[Argument]
AutoOpenApp = switch, false, true, tag = Tự mở thẳng app TestFlight, desc = Chuyển hướng itms-beta:// ngay khi bấm link

[General]
force-http-engine-hosts = tf-link.test

[Rule]
DOMAIN, tf-link.test, DIRECT
DOMAIN-KEYWORD, testflight.apple.com, DIRECT

[Host]
tf-link.test = 127.0.0.1

[Script]
http-request ^http:\/\/tf-link\.test(\/.*)?$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Link_Helper.js, requires-body = true, timeout = 20, tag = Quản Lý Hàng Đợi Offline, argument = [{AutoOpenApp}]
http-request ^https?:\/\/testflight\.apple\.com\/join\/[A-Za-z0-9]{5,12} script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Link_Helper.js, timeout = 15, tag = Tự Bắt Link TestFlight, argument = [{AutoOpenApp}]

[Mitm]
hostname = testflight.apple.com
