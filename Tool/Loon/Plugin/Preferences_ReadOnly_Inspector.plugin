#!name = Kiểm Tra Đọc Mạng Cài Đặt (com.apple.Preferences - Chỉ Đọc)
#!desc = Quan sát và phân loại lưu lượng mạng chỉ đọc (Read-Only 100%) cho com.apple.Preferences. Không sửa gói tin, tự động che khóa xác thực và không can thiệp SSL Pinning của Apple.
#!author = Antigravity Audit (v5.0.0.0)
#!homepage = https://support.apple.com/en-us/101555
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Apple.png
#!select = NotifyToast, false, true
#!date = 2026-11-15 23:20:00

[Rule]
DOMAIN, appleid.apple.com, DIRECT
DOMAIN, appleid.cdn-apple.com, DIRECT
DOMAIN, idmsa.apple.com, DIRECT
DOMAIN, gsa.apple.com, DIRECT
DOMAIN, setup.icloud.com, DIRECT
DOMAIN, configuration.apple.com, DIRECT
DOMAIN, mesu.apple.com, DIRECT
DOMAIN, gdmf.apple.com, DIRECT
DOMAIN, updates-http.cdn-apple.com, DIRECT
DOMAIN, updates.cdn-apple.com, DIRECT
DOMAIN, xp.apple.com, DIRECT
DOMAIN, captive.apple.com, DIRECT
DOMAIN, time-ios.apple.com, DIRECT
DOMAIN, time.apple.com, DIRECT
DOMAIN, iprofiles.apple.com, DIRECT
DOMAIN-SUFFIX, sandbox.itunes.apple.com, DIRECT
DOMAIN-SUFFIX, mzstorekit-sb.itunes.apple.com, DIRECT

[Script]
http-request ^http:\/\/(captive\.apple\.com|updates-http\.cdn-apple\.com|connectivitycheck\.platform\.hicloud\.com|www\.gstatic\.com)\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/Preferences_ReadOnly_Inspector.js, timeout = 20, tag = Preferences HTTP Request (Chỉ đọc), argument = [NotifyToast]
http-response ^http:\/\/(captive\.apple\.com|updates-http\.cdn-apple\.com|connectivitycheck\.platform\.hicloud\.com|www\.gstatic\.com)\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/Preferences_ReadOnly_Inspector.js, requires-body = true, timeout = 20, tag = Preferences HTTP Response (Chỉ đọc), argument = [NotifyToast]
http-request ^https?:\/\/(sandbox\.itunes\.apple\.com|mzstorekit-sb\.itunes\.apple\.com)\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/Preferences_ReadOnly_Inspector.js, requires-body = true, timeout = 20, tag = Preferences Sandbox Request (Chỉ đọc), argument = [NotifyToast]
http-response ^https?:\/\/(sandbox\.itunes\.apple\.com|mzstorekit-sb\.itunes\.apple\.com)\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/Preferences_ReadOnly_Inspector.js, requires-body = true, timeout = 20, tag = Preferences Sandbox Response (Chỉ đọc), argument = [NotifyToast]
cron "0 */10 * * * *" script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/Preferences_ReadOnly_Inspector.js, timeout = 15, tag = Kiểm tra Engine Preferences (Chỉ đọc), argument = [NotifyToast]
