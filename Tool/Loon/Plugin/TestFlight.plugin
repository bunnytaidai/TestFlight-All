#!name = Quản Lý Đa Tài Khoản & Mở Khóa Vùng TestFlight (Việt Hóa)
#!desc = Gộp chung nhiều tài khoản Apple ID TestFlight trên 1 máy, vượt giới hạn vùng quốc gia, giả lập tương thích mọi thiết bị (Universal) và tăng tốc tải CDN.
#!openUrl = http://boxjs.com
#!author = VirgilClyne & bunnytaidai
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!date = 2026-11-12 23:25:00

[Argument]
Switch = switch, true, tag = Bật mở khóa vùng quốc gia, desc = Bỏ chặn thông báo ứng dụng không khả dụng tại quốc gia của bạn
CountryCode = select, "US", "VN", "SG", "JP", "TW", "HK", "GB", tag = Mã vùng App Store, desc = Chọn quốc gia giả lập (Khuyên chọn US)
MultiAccount = switch, true, tag = Bật chế độ Đa tài khoản, desc = Giữ danh sách app Beta của nhiều nick Apple ID cùng lúc
Universal = switch, true, tag = Mở khóa giới hạn thiết bị, desc = Cho phép cài gói Beta giới hạn đời máy/iPadOS lên iPhone

[Rule]
DOMAIN-SUFFIX, testflight.apple.com, DIRECT

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/v1\/devices$ script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/switcher/box.switcher.js, timeout=60, tag="Đổi Nick Apple ID (BoxSwitcher)"
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/(session\/authenticate|properties\/testflight|accounts\/.*|messages\/.*|apps\/.*)$ script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.request.viethoa.js, requires-body=true, timeout=60, tag="TestFlight Multi-Account Request", argument=[Switch, CountryCode, MultiAccount, Universal]
http-response ^https?:\/\/testflight\.apple\.com\/v\d\/(session\/authenticate|accounts\/.*\/apps.*)$ script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.response.viethoa.js, requires-body=true, timeout=60, tag="TestFlight Multi-Account Response", argument=[Switch, CountryCode, MultiAccount, Universal]
http-request ^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps\/.*\/builds\/.*\/install$ script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Download.js, requires-body=true, timeout=60, tag="TestFlight Tải Nhanh CDN"

[MITM]
hostname = testflight.apple.com
