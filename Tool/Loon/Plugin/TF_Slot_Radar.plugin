#!name = Radar Canh Slot TestFlight Công Khai v5.4.0.0 (Chuẩn Loon 3.5+ — tf-radar.test)
#!desc = Quét trạng thái Slot công khai (OPEN / FULL) trực tiếp từ https://testflight.apple.com/join/<CODE> KHÔNG cần MitM hay Token (đã sửa lỗi timeout ms trên Loon 3.5+). Mở Safari: http://tf-radar.test/
#!openUrl = http://tf-radar.test/
#!author = Hely-T & Antigravity (v5.4.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!date = 2026-11-20 15:20:00

[Argument]
RADAR_IDS = input, "LPQmtkUs|Xh9VNQoA|2mcx1R3I|YSo8aVCS|CzpZHGuS", tag = Danh sách mã Radar, desc = Ngăn cách nhiều mã bằng dấu | hoặc dấu phẩy

[General]
force-http-engine-hosts = tf-radar.test

[Rule]
DOMAIN, tf-radar.test, DIRECT
DOMAIN-KEYWORD, testflight.apple.com, DIRECT

[Host]
tf-radar.test = 127.0.0.1

[Script]
http-request ^http:\/\/tf-radar\.test(\/.*)?$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Slot_Radar.js, requires-body = true, timeout = 25, tag = Bảng Web Radar Slot, argument = [{RADAR_IDS}]
cron "0 */2 * * * *" script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Slot_Radar.js, timeout = 25, tag = Quét Ngầm Radar TestFlight, argument = [{RADAR_IDS}]
