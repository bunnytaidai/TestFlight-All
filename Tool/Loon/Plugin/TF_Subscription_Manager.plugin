#!name = Quản Lý Gói Đăng Ký TestFlight Sandbox & Đảo Nick v5.4.0.0 (Chuẩn Loon 3.5+ — tf-sub.test)
#!desc = Quan sát chỉ đọc (Read-Only) gói đăng ký TestFlight/Sandbox theo từng nick Apple ID, đồng bộ GET apps (đã sửa lỗi timeout ms trên Loon 3.5+) tại http://tf-sub.test/
#!openUrl = http://tf-sub.test/
#!author = Hely-T & Antigravity (v5.4.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/appstore.png
#!date = 2026-11-20 15:20:00

[General]
force-http-engine-hosts = tf-sub.test

[Rule]
DOMAIN, tf-sub.test, DIRECT
DOMAIN-SUFFIX, sandbox.itunes.apple.com, DIRECT
DOMAIN-SUFFIX, mzstorekit-sb.itunes.apple.com, DIRECT
DOMAIN-SUFFIX, api.storekit-sandbox.itunes.apple.com, DIRECT

[Host]
tf-sub.test = 127.0.0.1

[Script]
http-request ^http:\/\/tf-sub\.test(\/.*)?$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Subscription_Manager.js, requires-body = true, timeout = 20, tag = Bảng Quản Lý Gói Sandbox
http-response ^https?:\/\/(sandbox\.itunes\.apple\.com|mzstorekit-sb\.itunes\.apple\.com|api\.storekit-sandbox\.itunes\.apple\.com)\/.* script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Subscription_Manager.js, requires-body = true, max-size = 524288, timeout = 25, tag = Ghi Nhận Gói Sandbox RO
cron "0 */15 * * * *" script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/TestFlight/TF_Subscription_Manager.js, timeout = 20, tag = Kiểm Tra Hạn Gia Hạn Sandbox

[Mitm]
hostname = sandbox.itunes.apple.com, mzstorekit-sb.itunes.apple.com, api.storekit-sandbox.itunes.apple.com
