#!name = Mở Khóa Gói Đăng Ký VIP & Tự Động Đổi Nick Apple ID (Loon Subscription Unlock)
#!desc = Tự động xóa ETag chống kẹt cache 304 khi đổi nick Apple ID và kích hoạt gói VIP/Premium cho RevenueCat, GoodNotes 6, Notability, Picsart, CamScanner, Fantastical, Slidebox, Meitu.
#!openUrl = https://testflight.apple.com/join/LPQmtkUs
#!author = Hely-T (v4.6.0.0)
#!homepage = https://github.com/bunnytaidai/TestFlight-All
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/appstore.png
#!date = 2026-11-04 18:00:00

[Script]
# RevenueCat Request: Xóa X-RevenueCat-ETag & If-None-Match khi đổi nick Apple ID để đăng ký gói mới ngay lập tức
http-request ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts)\/.*$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js, timeout = 60, tag = RevenueCat Clean ETag (Đổi Nick Apple ID)

# RevenueCat Response: Tự động kích hoạt gói VIP/Premium cho mọi nick Apple ID
http-response ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts)\/.*$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js, requires-body = true, timeout = 60, tag = RevenueCat Unlock VIP

# GoodNotes 6
http-request ^https?:\/\/isi\.csan\.goodnotes\.com\/.*\/subscribers\/.*$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js, timeout = 60, tag = GoodNotes 6 Request
http-response ^https?:\/\/isi\.csan\.goodnotes\.com\/.*\/(subscribers|receipts)\/.*$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js, requires-body = true, timeout = 60, tag = GoodNotes 6 Unlock

# Notability
http-response ^https?:\/\/notability\.com\/(global|subscriptions)$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/notability.js, requires-body = true, timeout = 60, tag = Notability Plus Unlock

# Picsart
http-response ^https?:\/\/api\.(picsart\.com|meiease\.cn)\/gw-v2\/shop\/subscription\/apple\/purchases$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Picsart/Picsart_crack.js, requires-body = true, timeout = 60, tag = Picsart Gold Unlock

# CamScanner
http-response ^https?:\/\/(api|api-cs)\.intsig\.net\/purchase\/cs\/query_property\? script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/CamScanner.js, requires-body = true, timeout = 60, tag = CamScanner VIP Unlock

# Fantastical
http-response ^https?:\/\/api\.flexibits\.com\/v1\/(auth\/device|account\/details)$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/fantastical.js, requires-body = true, timeout = 60, tag = Fantastical Unlock

# Slidebox
http-response ^https?:\/\/.*-slidebox-ios-prod\.cloudfunctions\.net\/get_subscription_status$ script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Slidebox.js, requires-body = true, timeout = 60, tag = Slidebox Unlock

# Meitu (Mtxx)
http-response ^https?:\/\/api\.sub\.meitu\.com\/v2\/user\/vip_info_by_group\.json script-path = https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Mtxx.js, requires-body = true, timeout = 60, tag = Meitu VIP Unlock

[Mitm]
hostname = api.revenuecat.com, isi.csan.goodnotes.com, notability.com, api.picsart.com, api.meiease.cn, api.intsig.net, api-cs.intsig.net, api.flexibits.com, *-slidebox-ios-prod.cloudfunctions.net, api.sub.meitu.com

