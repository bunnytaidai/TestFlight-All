#!name=❏ Auto TestFlight (Google Chrome Beta + Đổi Nick Apple ID)
#!desc=Tự động tham gia ứng dụng TF beta công khai (Mặc định: Google Chrome beta LPQmtkUs) và tự động xoay vòng đổi nick Apple ID.
#!system=ios
#!category=Third Party Module
#!arguments=INFO_FETCH_SCRIPT_NAME:Truy cập thông tin,CRON_SECONDS:1,START_HOUR:0,END_HOUR:23,APP_ID:LPQmtkUs
#!arguments-desc=[parameter settings]\n1. APP_ID: Mã ứng dụng TestFlight (Mặc định: LPQmtkUs - Google Chrome beta https://testflight.apple.com/join/LPQmtkUs);\n2. INFO_FETCH_SCRIPT_NAME: Tùy chỉnh điểm bắt đầu và điểm dừng của Script "thu thập thông tin";\n3. CRON_SECONDS: Khoảng thời gian giây thực thi Script;\n\n[Hướng dẫn]\n1. Mở ứng dụng TestFlight để nhận Mã thông báo Apple ID (hỗ trợ lưu nhiều nick);\n2. Tự động vào Google Chrome beta (LPQmtkUs) và xoay vòng qua các nick Apple ID đã lưu.

[Rule]
DOMAIN-SUFFIX,testflight.apple.com,DIRECT

[Script]
{{{INFO_FETCH_SCRIPT_NAME}}} = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/(v3\/accounts\/.*\/apps$|join\/[A-Za-z0-9]+|v3\/accounts\/.*\/ru\/.*|v1\/devices$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Auto_join_TF.js,argument=APP_ID={{{APP_ID}}}
Tham gia thử nghiệm = type=cron,cronexp="*/{{{CRON_SECONDS}}} * {{{START_HOUR}}}-{{{END_HOUR}}} * * *",script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Auto_join_TF.js,argument=APP_ID={{{APP_ID}}},wake-system=1,timeout=180,engine=auto

[MITM]
hostname = %APPEND% testflight.apple.com
