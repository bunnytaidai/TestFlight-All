#!name=通用解锁 (RevenueCat StoreKit 1 Unlock - v4.6.0.0)
#!desc=Revenuecat Unlock Surge@langkhach270389 & Hely-T (Tích hợp sẵn com.google.chrome.ios.30tb.ai.pro.m.iog)

[Header Rewrite]
.+ header-del if-modified-since
.+ header-del if-none-match
.+ header-del X-RevenueCat-ETag
.+ header-del x-revenuecat-etag

[URL Rewrite]
^https:\/\/(api\.revenuecat|isi.csan.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) https://api.langkhach89.workers.dev header

[Script]
RevenueCat_Req_Clean = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js,timeout=60
RevenueCat_Unlock = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, isi.csan.goodnotes.com
