#!name=Chuyển Đổi Đa Tài Khoản TestFlight (Multi-Account Apple ID)
#!desc=Hỗ trợ lưu và tự động chuyển đổi nhiều tài khoản Apple ID khi bấm biểu tượng Tài khoản góc phải trong ứng dụng TestFlight
#!author=VirgilClyne & Hely-T (v4.6.0.0)
#!category=Third Party Module
#!arguments=APPIDS:Auto_join_TF,ENGINE:auto
#!arguments-desc=[Tham số]\n▪︎ APPIDS: Chỉ định ID ứng dụng cần chuyển đổi phiên (Mặc định: Auto_join_TF);\n▪︎ ENGINE: Bộ máy thực thi (auto / jsc / webview);\n[Hướng dẫn]\n▫︎ Nhấn biểu tượng Tài khoản góc trên bên phải trong ứng dụng TestFlight để tự động chuyển sang nick Apple ID tiếp theo.

[General]
skip-proxy = %APPEND% iosapps.itunes.apple.com

[Rule]
DOMAIN-SUFFIX,testflight.apple.com,DIRECT

[Script]
Chuyển đổi phiên Apple ID = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/v1\/devices$,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/switcher/box.switcher.js,requires-body=1,argument={{{APPIDS}}},script-update-interval=0,timeout=30,engine={{{ENGINE}}}
TestFlight Đa Tài Khoản (Request) = type=http-request,requires-body=true,pattern=^https?:\/\/testflight\.apple\.com\/(.+)(\?.*)?$,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.request.viethoa.js,argument=Switch="true"&CountryCode="US"&MultiAccount="true"&Universal="true",timeout=60,engine={{{ENGINE}}}
TestFlight Đa Tài Khoản (Response) = type=http-response,requires-body=true,pattern=^https?:\/\/testflight\.apple\.com\/(.+)(\?.*)?$,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.response.viethoa.js,argument=Switch="true"&CountryCode="US"&MultiAccount="true"&Universal="true",timeout=60,engine={{{ENGINE}}}

[MITM]
hostname = %APPEND% testflight.apple.com
