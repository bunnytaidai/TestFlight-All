#!name=📦 BoxJS - Quản Lý Đa Tài Khoản Apple ID & APP_ID (Chống Lỗi DNS/Proxy)
#!desc=Trình quản lý dữ liệu Script (BoxJS) trên trình duyệt Safari (http://boxjs.com). Đã gắn sẵn [Host] 127.0.0.1 và ép DIRECT cho jsdelivr.net giúp mở tức thì kể cả khi không có Proxy ngoài.
#!openUrl=http://boxjs.com
#!author=chavyleung & Hely-T (v5.0.0.0)
#!homepage=https://github.com/bunnytaidai/TestFlight-All
#!icon=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/PNG/boxjs.png
#!system=ios
#!category=BoxJS

[Rule]
DOMAIN-SUFFIX,boxjs.com,DIRECT
DOMAIN-SUFFIX,boxjs.net,DIRECT
DOMAIN-SUFFIX,jsdelivr.net,DIRECT

[Host]
boxjs.com = 127.0.0.1
*.boxjs.com = 127.0.0.1
boxjs.net = 127.0.0.1
*.boxjs.net = 127.0.0.1

[Script]
BoxJS = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/boxjs/chavy.boxjs.js,timeout=60

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
enable = true
h2 = true
