#!name=✈️ Tự Động Tham Gia TestFlight 2 Tầng (Bộ 5 App Beta: Chrome, Aloha, VilaNet, Notion, Notion Calendar + Tự Đảo Nick Apple ID)
#!desc=Canh slot thông minh 2 tầng (kiểm tra trang công khai không tốn Token + tự đảo nick Apple ID bấm Accept). Mặc định săn sẵn 5 gói: Google Chrome (LPQmtkUs), Aloha VPN (Xh9VNQoA), VilaNet (2mcx1R3I), Notion (YSo8aVCS) & Notion Calendar Next (CzpZHGuS).
#!openUrl=http://tf-link.test/
#!author=DecoAri & Hely-T (v5.2.0.0)
#!homepage=https://github.com/bunnytaidai/TestFlight-All
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/testflight.png
#!arguments=APP_ID:LPQmtkUs|Xh9VNQoA|2mcx1R3I|YSo8aVCS|CzpZHGuS
#!arguments-desc=APP_ID: Danh sách mã TestFlight cần tham gia (Mặc định: LPQmtkUs|Xh9VNQoA|2mcx1R3I|YSo8aVCS|CzpZHGuS — Ngăn cách nhiều mã trong tham số Module bằng dấu gạch đứng '|').

[Rule]
DOMAIN-KEYWORD,testflight.apple.com,DIRECT
DOMAIN-SUFFIX,beta.apple.com,DIRECT

[Script]
# Tự động lấy Token (hỗ trợ cả URL có query ?platform=ios), thêm APP_ID và tự đổi nick Apple ID khi nhấn biểu tượng Tài khoản (/v1/devices)
TF_Auto_Get_Params = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/(v\d\/accounts\/[0-9a-fA-F-]{36}\/(apps|settings)(\?.*)?$|join\/[A-Za-z0-9]+|v3\/accounts\/[0-9a-fA-F-]{36}\/ru\/.*|v1\/devices(\?.*)?$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Shadowrocket/Auto_join_TF_Shadowrocket.js,argument=APP_ID={{{APP_ID}}},timeout=20

# Chạy ngầm mỗi 1 phút (bảo vệ giới hạn 15MB RAM PacketTunnel trên iOS A9 & chống khóa HTTP 429 của Apple)
TF_Auto_Join_Cron = type=cron,cronexp="0 */1 * * * *",script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Shadowrocket/Auto_join_TF_Shadowrocket.js,argument=APP_ID={{{APP_ID}}},wake-system=1,timeout=25

[MITM]
hostname = %APPEND% testflight.apple.com
enable = true
h2 = true
