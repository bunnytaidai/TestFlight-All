#!name=Tự Động Tham Gia TestFlight (Google Chrome Beta + Đổi Nick Apple ID)
#!desc=Tự động lấy Token, tự động xoay vòng đổi nick Apple ID và tự động tham gia Google Chrome beta (LPQmtkUs) cùng mọi link TestFlight.
#!author=DecoAri & Hely-T (v4.6.0.0)
#!arguments=APP_ID:LPQmtkUs
#!arguments-desc=APP_ID: Mã ứng dụng TestFlight cần tham gia (Mặc định: LPQmtkUs - Google Chrome beta. Phân cách nhiều mã bằng dấu phẩy).

[Rule]
DOMAIN-SUFFIX,testflight.apple.com,DIRECT

[Script]
# Tự động lấy Token, thêm APP_ID và tự động đổi nick Apple ID khi nhấn biểu tượng Tài khoản (/v1/devices)
TF_Auto_Get_Params = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/(v3\/accounts\/.*\/apps$|join\/.*|v3\/accounts\/.*\/ru\/.*|v1\/devices$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Shadowrocket/Auto_join_TF_Shadowrocket.js,argument=APP_ID={{{APP_ID}}},timeout=60

# Tự động chạy ngầm mỗi giây để săn slot TestFlight (Google Chrome beta LPQmtkUs) và tự xoay vòng qua tất cả các nick Apple ID đã lưu
TF_Auto_Join_Cron = type=cron,cronexp="* * * * * *",script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Shadowrocket/Auto_join_TF_Shadowrocket.js,argument=APP_ID={{{APP_ID}}},wake-system=1,timeout=60

[MITM]
hostname = %APPEND% testflight.apple.com
enable = true
h2 = true
