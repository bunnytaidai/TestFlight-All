#!name=✈️ Hely-T: TestFlight Đa Khu Vực & Bỏ Giới Hạn Thiết Bị (Shadowrocket)
#!desc=1. Tùy chỉnh khu vực cửa hàng TestFlight 2. Lưu và chuyển đổi nhiều tài khoản TestFlight 3. Cho phép cài đặt ứng dụng TestFlight vượt giới hạn thiết bị Apple.
#!openUrl=http://boxjs.com/#/app/iRingo.TestFlight
#!author=Hely-T & bunnytaidai
#!homepage=https://github.com/bunnytaidai/TestFlight-All
#!icon=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/PNG/TestFlight_2.png
#!system=ios
#!category=TestFlight

[General]
skip-proxy = %APPEND% iosapps.itunes.apple.com

[Script]
TestFlight.request = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/,requires-body=1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.request.viethoa.js,timeout=60
TestFlight.response = type=http-response,pattern=^https?:\/\/testflight\.apple\.com\/,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/FileFastClick/TestFlight.response.viethoa.js,timeout=60

[MITM]
hostname = %APPEND% testflight.apple.com
