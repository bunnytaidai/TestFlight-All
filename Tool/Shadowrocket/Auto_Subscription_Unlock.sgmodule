#!name=Mở Khóa Gói Đăng Ký VIP & Tự Động Đổi Nick Apple ID (Subscription Unlock)
#!desc=Tự động xóa X-RevenueCat-ETag chống kẹt cache 304 khi đổi nick Apple ID và mở khóa gói đăng ký StoreKit 1 (com.google.chrome.ios.30tb.ai.pro.m.iog, RevenueCat, GoodNotes 6, Notability, Picsart, CamScanner, Fantastical, Slidebox, Meitu).
#!author=Hely-T (v4.6.0.0)

[Script]
# RevenueCat Request: Xóa X-RevenueCat-ETag & If-None-Match khi đổi nick Apple ID để ép máy chủ trả về 200 OK (chống lỗi 304 Not Modified)
RevenueCat_Req_Clean = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js,timeout=60

# RevenueCat Response: Ánh xạ Mapping (com.google.chrome.ios.30tb.ai.pro.m.iog) & bơm JSON StoreKit 1 đã kiểm duyệt Schema
RevenueCat_Unlock = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js,timeout=60

# GoodNotes 6
GoodNotes_Req = type=http-request,pattern=^https?:\/\/isi\.csan\.goodnotes\.com\/.*\/subscribers\/.*$,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js,timeout=60
GoodNotes_Resp = type=http-response,pattern=^https?:\/\/isi\.csan\.goodnotes\.com\/.*\/(subscribers|receipts)\/.*$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js,timeout=60

# Notability
Notability_Unlock = type=http-response,pattern=^https?:\/\/notability\.com\/(global|subscriptions)$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/notability.js,timeout=60

# Picsart
Picsart_Unlock = type=http-response,pattern=^https?:\/\/api\.(picsart\.com|meiease\.cn)\/gw-v2\/shop\/subscription\/apple\/purchases$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Picsart/Picsart_crack.js,timeout=60

# CamScanner
CamScanner_Unlock = type=http-response,pattern=^https?:\/\/(api|api-cs)\.intsig\.net\/purchase\/cs\/query_property\?,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/CamScanner.js,timeout=60

# Fantastical
Fantastical_Unlock = type=http-response,pattern=^https?:\/\/api\.flexibits\.com\/v1\/(auth\/device|account\/details)$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/fantastical.js,timeout=60

# Slidebox
Slidebox_Unlock = type=http-response,pattern=^https?:\/\/.*-slidebox-ios-prod\.cloudfunctions\.net\/get_subscription_status$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Slidebox.js,timeout=60

# Meitu (Mtxx)
Meitu_Unlock = type=http-response,pattern=^https?:\/\/api\.sub\.meitu\.com\/v2\/user\/vip_info_by_group\.json,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Mtxx.js,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, isi.csan.goodnotes.com, notability.com, api.picsart.com, api.meiease.cn, api.intsig.net, api-cs.intsig.net, api.flexibits.com, *-slidebox-ios-prod.cloudfunctions.net, api.sub.meitu.com
enable = true
h2 = true
