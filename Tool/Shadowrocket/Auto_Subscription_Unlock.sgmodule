#!name=💎 Tự Động Đăng Ký Gói VIP / Mở Khóa IAP (Shadowrocket All-in-One)
#!desc=Tự động đăng ký gói & mở khóa tính năng Pro/Premium (RevenueCat, GoodNotes 6, PicsArt, Notability, CamScanner, Fantastical, Slidebox, Meitu) cho Shadowrocket trên iOS 17.7 chưa JB.
#!author=Hely-T & bunnytaidai (Shadowrocket Edition)
#!homepage=https://github.com/bunnytaidai/TestFlight-All
#!icon=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/PNG/apple.png
#!system=ios
#!category=VIP Unlock

[Header Rewrite]
^https?:\/\/(api\.revenuecat|isi\.csan\.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) header-del if-modified-since
^https?:\/\/(api\.revenuecat|isi\.csan\.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) header-del if-none-match
^https?:\/\/(api\.revenuecat|isi\.csan\.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) header-del X-RevenueCat-ETag
^https?:\/\/(api\.revenuecat|isi\.csan\.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) header-del x-revenuecat-etag

[URL Rewrite]
# Mở khóa chung các ứng dụng dùng cổng thanh toán RevenueCat
^https:\/\/(api\.revenuecat|isi\.csan\.goodnotes)\.com\/.+\/(receipts$|subscribers\/[^/]+$|offers$) https://api.langkhach89.workers.dev header

[Script]
# 1. GoodNotes 6 Unlock
GoodNotes6_Request = type=http-request,pattern=^https?:\/\/isi\.csan\.goodnotes\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js,timeout=60
GoodNotes6_Response = type=http-response,pattern=^https?:\/\/isi\.csan\.goodnotes\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Goodnotes/Goodnotes_crack.js,timeout=60

# 2. RevenueCat Response Fallback
RevenueCat_Response = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers)\/?(.*)*$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/revenuecat.js,timeout=60

# 3. PicsArt Plus Yearly Subscription
PicsArt_VIP = type=http-response,pattern=^https?:\/\/api\.(picsart\.com|meiease\.cn)\/gw-v2\/shop\/subscription\/apple\/purchases,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Resource/Script/Picsart/Picsart_crack.js,timeout=60

# 4. Notability Premium Subscription
Notability_VIP = type=http-response,pattern=^https?:\/\/notability\.com\/subscriptions,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/notability.js,timeout=60

# 5. CamScanner SVIP Yearly Subscription
CamScanner_VIP = type=http-response,pattern=^https:\/\/(api|api-cs)\.intsig\.net\/purchase\/cs\/query_property\?,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/CamScanner.js,timeout=60

# 6. Fantastical Flexibits Subscription
Fantastical_VIP = type=http-response,pattern=^https:\/\/api\.flexibits\.com\/v1\/(auth|account)\/(device|details|appstore-receipt)\/$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/fantastical.js,timeout=60

# 7. Slidebox Full Version IAP
Slidebox_VIP = type=http-response,pattern=^https?:\/\/.*slidebox.*\/validateReceipt,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Slidebox.js,timeout=60

# 8. Meitu (Mtxx) VIP Subscription
Meitu_VIP = type=http-response,pattern=^https?:\/\/(api|h5)\.xiuxiu\.meitu\.com\/(?!(v\d\/feed\/|v\d\/search\/|v\d\/channel\/)),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/bunnytaidai/TestFlight-All/master/Tool/Surge5/Mtxx.js,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, isi.csan.goodnotes.com, api.picsart.com, api.meiease.cn, notability.com, ap*.intsig.net, api.flexibits.com, *.slidebox.co, api.xiuxiu.meitu.com, h5.xiuxiu.meitu.com
