#!name=Rabbit TestFlight Multi-Account AutoJoin & Sub Guard
#!desc=Lưu đa nick Apple ID, tự đảo nick săn 5 link TestFlight (LPQmtkUs, Xh9VNQoA, 2mcx1R3I, YSo8aVCS, CzpZHGuS) và theo dõi gói đăng ký cố định.
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,apple.com)),REJECT
DOMAIN,testflight.apple.com,DIRECT
DOMAIN,buy.itunes.apple.com,DIRECT
DOMAIN,sandbox.itunes.apple.com,DIRECT
DOMAIN,mzstorekit-sb.itunes.apple.com,DIRECT
DOMAIN,api.storekit-sandbox.itunes.apple.com,DIRECT

[Script]
TF_Luu_AppleID = type=http-request,pattern=^https:\/\/testflight\.apple\.com\/v[23]\/accounts\/([0-9a-fA-F-]+)\/apps,requires-body=0,timeout=15,script-path=http://192.168.1.100:8899/tf_manager_core.js

TF_KiemTra_Goi_SK1 = type=http-response,pattern=^https:\/\/(buy|sandbox)\.itunes\.apple\.com\/verifyReceipt,requires-body=1,max-size=524288,timeout=20,script-path=http://192.168.1.100:8899/tf_manager_core.js

TF_KiemTra_Goi_SK2 = type=http-response,pattern=^https:\/\/(mzstorekit-sb\.itunes\.apple\.com|api\.storekit-sandbox\.itunes\.apple\.com)\/.*,requires-body=1,max-size=524288,timeout=20,script-path=http://192.168.1.100:8899/tf_manager_core.js

TF_DaoNick_SanSlot_GiaHan = type=cron,cronexp="*/20 * * * * *",wake-system=1,timeout=25,argument="TF_CODES=LPQmtkUs,Xh9VNQoA,2mcx1R3I,YSo8aVCS,CzpZHGuS&TARGET_PRODUCTS=*&JOIN_ALL=false",script-path=http://192.168.1.100:8899/tf_manager_core.js

[MITM]
hostname = %APPEND% testflight.apple.com, buy.itunes.apple.com, sandbox.itunes.apple.com, mzstorekit-sb.itunes.apple.com, api.storekit-sandbox.itunes.apple.com
